{
  "realm": "casino",
  "displayName": "Casino (laboratorio)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "defaultRole": {
    "name": "default-roles-casino"
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-casino",
        "description": "Roles que recibe todo usuario nuevo del realm",
        "composite": true,
        "composites": {
          "realm": ["player", "offline_access", "uma_authorization"]
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "player",
        "description": "Jugador: puede apostar y consultar su cuenta"
      },
      {
        "name": "backoffice",
        "description": "Personal de backoffice: ajustes y auditoria"
      },
      {
        "name": "cashier",
        "description": "Cajero: carga fichas (de su saldo) a los jugadores de su jurisdiccion. Tambien es jugador"
      },
      {
        "name": "head_cashier",
        "description": "Jefe de cajeros: carga fichas (de su saldo) a los cajeros de su jurisdiccion. Tambien es jugador"
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "${GOOGLE_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:sin-configurar}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:sin-configurar}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clients": [
    {
      "clientId": "casino-web",
      "name": "Casino Web",
      "description": "Aplicacion de navegador (React). Cliente publico: usa el flujo Authorization Code con PKCE, sin secreto.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "https://192.168.*", "https://10.*", "https://172.*"],
      "webOrigins": ["http://localhost:5173", "https://192.168.*", "https://10.*", "https://172.*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://192.168.*##https://10.*##https://172.*"
      },
      "protocolMappers": [
        {
          "name": "audience-casino-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "casino-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "casino-api",
      "name": "Casino API",
      "description": "Servidor de recursos: solo valida tokens, nunca inicia sesiones.",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "casino-tests",
      "name": "Casino Tests",
      "description": "SOLO PARA PRUEBAS AUTOMATIZADAS: permite pedir un token con usuario y contraseña. No usar desde el front.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-casino-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "casino-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "0a1b2c3d-0001-4000-8000-000000000001",
      "username": "jugador1",
      "enabled": true,
      "emailVerified": true,
      "email": "jugador1@casino.test",
      "firstName": "Jugador",
      "lastName": "Uno",
      "credentials": [{ "type": "password", "value": "jugador1-dev", "temporary": false }],
      "realmRoles": ["default-roles-casino"]
    },
    {
      "id": "0a1b2c3d-0002-4000-8000-000000000002",
      "username": "jugador2",
      "enabled": true,
      "emailVerified": true,
      "email": "jugador2@casino.test",
      "firstName": "Jugador",
      "lastName": "Dos",
      "credentials": [{ "type": "password", "value": "jugador2-dev", "temporary": false }],
      "realmRoles": ["default-roles-casino"]
    },
    {
      "id": "0a1b2c3d-0003-4000-8000-000000000003",
      "username": "backoffice1",
      "enabled": true,
      "emailVerified": true,
      "email": "backoffice1@casino.test",
      "firstName": "Backoffice",
      "lastName": "Uno",
      "credentials": [{ "type": "password", "value": "backoffice1-dev", "temporary": false }],
      "realmRoles": ["backoffice"]
    },
    {
      "id": "0a1b2c3d-0004-4000-8000-000000000004",
      "username": "jefe1",
      "enabled": true,
      "emailVerified": true,
      "email": "jefe1@casino.test",
      "firstName": "Jefe",
      "lastName": "Uno",
      "credentials": [{ "type": "password", "value": "jefe1-dev", "temporary": false }],
      "realmRoles": ["default-roles-casino", "head_cashier"]
    },
    {
      "id": "0a1b2c3d-0005-4000-8000-000000000005",
      "username": "cajero1",
      "enabled": true,
      "emailVerified": true,
      "email": "cajero1@casino.test",
      "firstName": "Cajero",
      "lastName": "Uno",
      "credentials": [{ "type": "password", "value": "cajero1-dev", "temporary": false }],
      "realmRoles": ["default-roles-casino", "cashier"]
    }
  ]
}
